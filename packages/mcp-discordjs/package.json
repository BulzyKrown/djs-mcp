{
  "name": "@gentleman-programming/mcp-discordjs",
  "version": "1.6.1",
  "description": "Model Context Protocol server for discord.js documentation - 17 tools for searching classes, interfaces, enums, methods, and more",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "mcp-discordjs": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cheerio": "^1.0.0",
    "domhandler": "^5.0.3",
    "lru-cache": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord.js",
    "discord",
    "bot",
    "documentation",
    "docs",
    "chatbot"
  ],
  "author": "gentleman-programming",
  "license": "Apache-2.0",
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gentleman-programming/mcp-discordjs"
  },
  "bugs": {
    "url": "https://github.com/gentleman-programming/mcp-discordjs/issues"
  },
  "homepage": "https://github.com/gentleman-programming/mcp-discordjs#readme"
}